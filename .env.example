# Minecraft Server Directory (host path)
MINECRAFT_DIR=/path/to/server-directory

# Container name
CONTAINER_NAME=minecraft-server

# Memory allocation (e.g., 4096M, 2G)
MEMORY=4096M

# Max players
MAX_PLAYERS=20

# RCON password (for remote console)
RCON_PASSWORD=change-me

# Difficulty: 0=Peaceful, 1=Easy, 2=Normal, 3=Hard
DIFFICULTY=2

# Gamemode: 0=Survival, 1=Creative, 2=Adventure, 3= Spectator
GAMEMODE=0
